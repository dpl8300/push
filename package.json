{
  "name": "push",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "start": "cross-env APP_VARIANT=development expo start --dev-client --scheme push-dev",
    "ios": "cross-env APP_VARIANT=development expo run:ios",
    "ios:device": "cross-env APP_VARIANT=development expo run:ios --device",
    "android": "cross-env APP_VARIANT=development expo run:android",
    "android:device": "cross-env APP_VARIANT=development expo run:android --device",
    "prebuild": "cross-env APP_VARIANT=development expo prebuild",
    "prebuild:clean": "cross-env APP_VARIANT=development expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@expo/ui": "~57.0.12",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  }
}
